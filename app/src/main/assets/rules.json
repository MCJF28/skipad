{
  "version": 2,
  "rules": [
    {
      "pkg": "tv.danmaku.bili",
      "enabled": true,
      "delayMs": 60,
      "windowMs": 6000,
      "maxClicks": 1,
      "cooldownMs": 0,
      "anchor": "广告",
      "regionFx": 0.868,
      "regionFy": 0.929,
      "matchers": [
        {
          "type": "text",
          "value": "跳过"
        },
        {
          "type": "regex",
          "value": "^跳过\\s*\\d*\\s*[sS]?$"
        }
      ],
      "pairs": [
        {
          "when": "展示广告",
          "tap": "取消"
        }
      ]
    },
    {
      "pkg": "com.autonavi.minimap",
      "enabled": true,
      "delayMs": 60,
      "windowMs": 6000,
      "maxClicks": 1,
      "cooldownMs": 0,
      "anchor": "",
      "regionFx": 0.0,
      "regionFy": 0.0,
      "matchers": [
        {
          "type": "text",
          "value": "跳过"
        },
        {
          "type": "regex",
          "value": "^跳过\\s*\\d*\\s*[sS]?$"
        }
      ]
    }
  ]
}
